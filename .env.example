# Sign-in with Microsoft Entra ID (SAML). Setup: docs/entra-sso.md. Without SAML_ENTRY_POINT,
# dev runs with sign-in off and production refuses to start (unless AUTH_DISABLED=1).
SAML_ENTRY_POINT=
SAML_LOGOUT_URL=
# Entra's "Certificate (Base64)" on one line, without the BEGIN/END lines.
SAML_IDP_CERT=
# Must equal the Identifier (Entity ID) in Entra.
SAML_ISSUER=urn:tender-sites-portal
# The origin people open the app at. Entra's Reply URL is APP_BASE_URL/api/auth/saml/acs.
APP_BASE_URL=http://localhost:5173
# Encrypts the session cookie. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# SESSION_HOURS=8
# AUTH_DISABLED=1

# Required for /transactions. URA Data Service access key (server-side only, never commit it).
# Register at https://eservice.ura.gov.sg/maps/api/reg.html
URA_ACCESS_KEY=

# Port the API listens on (default 3000). In dev the API always uses API_PORT (default 3000)
# and Vite serves the front end on 5173.
# PORT=3000

# Optional. Enables the "AI assessment" in each site's Price estimate (Claude Opus 5.5).
# Server-side only; each new assessment is one paid call, cached for 24 h. Set ONE provider:
# 1) Amazon Bedrock (used first when set). Bedrock API key; prefer short-term keys in production.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-opus-5-5
# 2) Anthropic API
ANTHROPIC_API_KEY=

# Where saved AI assessments live (one JSON per parcel). Default: <repo>/.data/ai-assessments
# ASSESSMENT_STORE_DIR=

# Optional. Used only by `npm run data:refresh` to geocode schools faster.
# Register at https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Tender documents (COT / TCOT upload and generation) via Bedrock AgentCore. Server-side only.
COGNITO_TOKEN_URL=https://my-domain-poenhrym.auth.ap-southeast-1.amazoncognito.com/oauth2/token
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=gw-cdlappplt-gi-ai-agent/genesis-gateway:invoke
AGENTCORE_RUNTIME_URL=https://bedrock-agentcore.ap-southeast-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aap-southeast-1%3A550236650413%3Aruntime%2FGIAgentResearcher_GI_AI_Agent_Orchestrator-Aiet6Z4OWz/invocations

# Extra sites for the proof of concept (comma-separated URA slugs), e.g. closed tenders with
# documents already in the agent. Default: marina-gardens-lane-aug26. Set empty to show none.
# POC_SITE_SLUGS=marina-gardens-lane-aug26

# How long Generate waits for the agent before replying 202 and letting the page poll (ms).
# Keep it under your load balancer's request timeout (App Runner: 120 s). Default 100000.
# GENERATE_WAIT_MS=100000
