{
  "name": "tender-sites-portal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/core", "apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "start": "node apps/api/dist/server.js",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "data:refresh": "npm run data:refresh -w packages/core"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
